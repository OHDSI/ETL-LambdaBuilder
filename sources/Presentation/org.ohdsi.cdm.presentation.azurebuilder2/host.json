{
  "version": "2.0",
  "retry": {
    "strategy": "fixedDelay",
    "maxRetryCount": 0,
    "delayInterval": "00:00:01"
  },
  "functionTimeout": "00:30:00",
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 1,
      "maxPollingInterval": "00:00:01",
      "visibilityTimeout": "00:25:00"
    }
  },
  "telemetryMode": "OpenTelemetry",
  "concurrency": {
    "dynamicConcurrencyEnabled": false
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function": "Information"
    }
  }
}