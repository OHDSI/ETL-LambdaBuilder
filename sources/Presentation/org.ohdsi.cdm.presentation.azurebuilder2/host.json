{
  "version": "2.0",
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxPollingInterval": "00:00:01"
    }
  },
  "telemetryMode": "OpenTelemetry",
  "concurrency": {
    "dynamicConcurrencyEnabled": false
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function": "Information"
    }
  }
}