<QueryDefinition>
	<Query>
		select
		ch.person_id as PersonId,
		i.immunization_date,
		i.ndc,
		i.immunization_desc,
		case
		when i.ndc is null then i.immunization_desc
		else i.ndc || '-' || i.immunization_desc
		end as immunization_source,
		1 as fake,
		1 as itNdc,
		ch.PartitionId
		from {sc}.immunizations as i
		JOIN {ch_sc}._chunks ch ON ch.ChunkId = {0} AND i.ptid = ch.PERSON_SOURCE_VALUE
		where i.immunization_date is not null
		order by ch.PartitionId, ch.person_id
	</Query>
	<DrugExposure>
		<DrugExposureDefinition>
			<PersonId>PersonId</PersonId>
			<StartDate>immunization_date</StartDate>
			<EndDate>immunization_date</EndDate>
			<AdditionalFields>
				<string>itNdc</string>
				<string>immunization_desc</string>
				<string>immunization_source</string>
			</AdditionalFields>
			<Concepts>
				<Concept>
					<ConceptIdMappers>
						<Mapper>
							<Lookup>Drug</Lookup>
						</Mapper>
					</ConceptIdMappers>
					<Fields>
						<Field key="ndc" defaultTypeId="32818" eventDate="immunization_date" />
					</Fields>
				</Concept>
			</Concepts>
		</DrugExposureDefinition>
		<!-- fake definition, only to load lookups  -->
		<DrugExposureDefinition>
			<Condition>{fake} = 0</Condition>
			<PersonId>PersonId</PersonId>
			<Concepts>
				<Concept>
					<ConceptIdMappers>
						<Mapper>
							<Lookup>EhrVax</Lookup>
						</Mapper>
					</ConceptIdMappers>
					<Fields>
						<Field key="fake" typeId="1" sourceKey="fake"/>
					</Fields>
				</Concept>
			</Concepts>
		</DrugExposureDefinition>
	</DrugExposure>
</QueryDefinition>